+        if (cursor.gpr > 9) {
+            cursor.gpr = 11;
+            cursor.stack += cursor.stack & 1;
+        }
+        const uint64_t high = next_word(ctx, cursor);
+        const uint64_t v = (high << 32) | next_word(ctx, cursor);
         return static_cast<T>(v);
     } else {
