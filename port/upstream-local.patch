+                        std::fprintf(stderr, "cafe: account Mii from %s\n", path);
+                        return m;
+                    }
+                }
+                std::fclose(f);
+            }
+            std::fprintf(stderr, "cafe: no valid MiiData in CAFE_ACCOUNT_DAT=%s, using the default Mii\n", path);
+        }
+        return make_default_mii();
+    }();
