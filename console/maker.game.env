# Super Mario Maker: read by launch.sh before the start.
# The editor and most menus are on the GamePad: its picture is shown (the left stick click switches to the TV
# picture and back); the right stick moves the touch cursor, ZR or a right stick click touches.
export TTT2_SHOW_GAMEPAD=1 CAFE_TOUCH_UI=1
# The tile atlas has CPU-written parts (ground): render targets start from / pick up their guest memory.
export TTT2_RELOAD_TARGETS=1
# Guest memory (MEM2) as GPU memory instead of an imported host pointer: amdgpu re-walks a host-pointer import on
# every submission (console: 11 ms a frame of kernel time; with this 2.6 ms, 60 fps).
export TTT2_GUEST_DMABUF=1
